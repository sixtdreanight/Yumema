# 复制为 .env 并按需填写。切勿将真实密钥提交到 git。

# ---- AI 配置 ----
# 提供商: anthropic | openai | openai-compatible | ollama
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-4-20250514
AI_API_KEY=your_api_key_here
# AI_BASE_URL=
# AI_MAX_TOKENS=
# AI_TEMPERATURE=

# ---- QQ (NapCatQQ / OneBot) 配置 ----
QQ_WS_URL=ws://127.0.0.1:3001
QQ_ACCESS_TOKEN=your_token_here

# ---- 微信 (Gewechat) 配置 ----
WECHAT_BASE_URL=http://127.0.0.1:2531/v2/api
WECHAT_FILE_URL=http://127.0.0.1:2532/download
# WECHAT_TOKEN=
# WECHAT_APPID=
